# Frontend Environment Configuration

# API Configuration
# Base URL for backend API calls
VITE_API_BASE_URL=http://localhost:5157/api

# Application Configuration
# App environment (development, staging, production)
VITE_APP_ENV=development

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_LOGGING=true

# Note: 
# - Variables must be prefixed with VITE_ to be accessible in the frontend
# - Copy this file to .env.local and fill in actual values
# - Never commit .env.local with sensitive information
